#!/bin/bash
# Installs (or updates after editing domains.txt / split.sh / connection.conf) the Fairlyne
# VPN split tunnel.
# Usage: sudo ~/.config/fairlyne-vpn/install
# Everything it puts outside this folder is listed below and removed by ./uninstall.

set -euo pipefail
# set -e stops silently: say where.
trap 'echo "install: failed at line $LINENO: $BASH_COMMAND" >&2' ERR

[[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo $0" >&2; exit 1; }

HERE=$(dirname "$(realpath "$0")")
NM_CONF=/etc/NetworkManager/conf.d/fairlyne-vpn.conf
DNSMASQ_CONF=/etc/NetworkManager/dnsmasq.d/fairlyne-vpn.conf
DISPATCHER=/etc/NetworkManager/dispatcher.d/50-fairlyne-vpn
CONNECTION_FILE=$(sed -n 's/^CONNECTION_FILE=\([^ ]*\).*/\1/p' "$HERE/split.sh")
NFT_TABLE=$(sed -n 's/^NFT_TABLE="\(.*\)".*/\1/p' "$HERE/split.sh")
ROUTE_TABLE=$(sed -n 's/^ROUTE_TABLE=\([^ ]*\).*/\1/p' "$HERE/split.sh")

[[ -f $HERE/connection.conf ]] ||
    { echo "Missing $HERE/connection.conf: copy connection.conf.example and fill it in" >&2; exit 1; }
VPN_UUID= VPN_SERVER_PORT=
# shellcheck source=/dev/null
source "$HERE/connection.conf"
[[ $VPN_UUID =~ ^[0-9a-f-]{36}$ ]] || { echo "connection.conf: invalid VPN_UUID" >&2; exit 1; }
[[ $VPN_SERVER_PORT =~ ^[0-9]{1,5}$ ]] || { echo "connection.conf: invalid VPN_SERVER_PORT" >&2; exit 1; }
nmcli -t -f UUID connection show | grep -qx "$VPN_UUID" ||
    { echo "connection.conf: no NetworkManager connection with UUID $VPN_UUID" >&2; exit 1; }

# domains.txt -> dnsmasq nftset lines
domains=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$HERE/domains.txt" | grep -v '^$' || true)
[[ -n $domains ]] || { echo "domains.txt is empty" >&2; exit 1; }
if bad=$(grep -Ev '^[A-Za-z0-9.-]+$' <<<"$domains"); then
    echo "Invalid domain(s) in domains.txt: $bad" >&2; exit 1
fi
{
    echo "# Generated by $HERE/install from domains.txt: edit that file, not this one."
    while read -r domain; do
        echo "nftset=/$domain/4#inet#$NFT_TABLE#dst4,6#inet#$NFT_TABLE#dst6"
    done <<<"$domains"
} >"$DNSMASQ_CONF"
echo "Wrote $DNSMASQ_CONF ($(wc -l <<<"$domains") domain(s))"

printf '# Installed by %s/install\n[main]\ndns=dnsmasq\n' "$HERE" >"$NM_CONF"
echo "Wrote $NM_CONF"

# Root-owned and rebuilt from the validated values: the dispatcher runs as root and sources it.
printf '# Generated by %s/install from connection.conf: edit that file, not this one.\nVPN_UUID="%s"\nVPN_SERVER_PORT=%s\n' \
    "$HERE" "$VPN_UUID" "$VPN_SERVER_PORT" >"$CONNECTION_FILE"
chmod 644 "$CONNECTION_FILE"
echo "Wrote $CONNECTION_FILE"

install -o root -g root -m 755 "$HERE/split.sh" "$DISPATCHER"
echo "Installed $DISPATCHER"

# Routing domains (~): while the VPN is up, dnsmasq resolves them with the DNS it pushes.
dns_search=$(sed 's/^/~/' <<<"$domains" | paste -sd,)
dns_search_before=$(nmcli -g ipv4.dns-search connection show "$VPN_UUID")
nmcli connection modify "$VPN_UUID" ipv4.never-default yes ipv6.never-default yes ipv4.dns-search "$dns_search"
echo "VPN connection: never-default enabled, routing domains $dns_search (both take effect at next connection)"

# Rebuild the nftables table so that edits to its definition in split.sh take effect, then
# re-apply the VPN rules if the tunnel is up in split mode.
# The table does not exist until a route is put in it: ip exits 2, which must not stop us.
vpn_iface=$(ip route show table "$ROUTE_TABLE" 2>/dev/null | sed -n 's/^default dev \([^ ]*\).*/\1/p' || true)
nft delete table inet "$NFT_TABLE" 2>/dev/null || true
"$DISPATCHER" none install
if [[ -n $vpn_iface ]]; then
    CONNECTION_UUID=$VPN_UUID VPN_IP_IFACE=$vpn_iface \
        VPN_IP4_NAMESERVERS=$(nmcli -g IP4.DNS connection show "$VPN_UUID" | sed 's/ | / /g') \
        "$DISPATCHER" "$vpn_iface" vpn-up
    echo "VPN rules re-applied on $vpn_iface"
fi

nmcli general reload
echo "NetworkManager reloaded: dnsmasq now resolves locally."

if nmcli -t -f UUID connection show --active | grep -qx "$VPN_UUID"; then
    if [[ -z $vpn_iface ]]; then
        echo "The VPN is connected in full-tunnel mode: disconnect and reconnect it to switch to split mode."
    elif [[ $dns_search != "$dns_search_before" ]]; then
        echo "domains.txt changed: disconnect and reconnect the VPN to apply its DNS routing."
    fi
fi
